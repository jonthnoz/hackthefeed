# Copy to .env. Bun loads it for the local server. Keep keys out of VITE_ variables.
# Provider setup: docs/providers.md
# Required for live Oriane research, independent of the AI provider.
ORIANE_API_KEY=

# codex (default), claude, or openai-compatible
AI_PROVIDER=codex
# Optional for CLI providers; Codex ignores user config. Required for openai-compatible.
# API models must support images and strict JSON Schema output.
AI_MODEL=
# Optional: low, medium, high. Leave empty for the provider default.
# Set only when the selected model supports reasoning controls.
AI_REASONING_EFFORT=
# Required for openai-compatible: HTTP(S), with the service's version prefix.
# No embedded credentials, query parameters, or fragment.
AI_BASE_URL=
# API credential. Leave empty only if the endpoint needs no authentication.
AI_API_KEY=
# Per provider call, 1 to 3600000 milliseconds. Default: 240000.
AI_TIMEOUT_MS=240000

# No authentication. Use 0.0.0.0 only on a trusted LAN.
HOST=127.0.0.1
# Integer from 1 to 65535.
PORT=3000
