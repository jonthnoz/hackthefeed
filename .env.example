# Copy to .env. Bun loads it for the local server. Never expose keys via VITE_ variables.
# Required for live Oriane research, independent of the AI provider.
ORIANE_API_KEY=

# codex (default), claude, or openai-compatible
AI_PROVIDER=codex
# Optional for CLI providers. Required for openai-compatible.
AI_MODEL=
# Optional: low, medium, high. Leave empty for the provider default.
# API models must explicitly support reasoning_effort before setting this.
AI_REASONING_EFFORT=
# Required for openai-compatible. Include /v1 where the service requires it.
AI_BASE_URL=
# Your provider key for OpenRouter. May be empty for a local HTTP server.
AI_API_KEY=
# Positive integer in milliseconds. Default: 240000.
AI_TIMEOUT_MS=240000

# No authentication. Use 0.0.0.0 only on a trusted LAN.
HOST=127.0.0.1
PORT=3000

# Run from the repository root after bun install and setting ORIANE_API_KEY above.
# Codex CLI must be installed and authenticated:
# codex login
# AI_PROVIDER=codex bun run dev
# Claude Code CLI must be installed and authenticated:
# claude auth login
# AI_PROVIDER=claude bun run dev
# OpenRouter: set AI_API_KEY above to your own key first.
# REPLACE_WITH_VISION_AND_JSON_SCHEMA_MODEL is a placeholder, not a working default.
# AI_PROVIDER=openai-compatible AI_BASE_URL=https://openrouter.ai/api/v1 AI_MODEL=REPLACE_WITH_VISION_AND_JSON_SCHEMA_MODEL bun run dev
# LM Studio: start its local server and load a compatible model first.
# AI_PROVIDER=openai-compatible AI_BASE_URL=http://localhost:1234/v1 AI_MODEL=REPLACE_WITH_LOADED_MODEL_ID bun run dev
# Ollama: start its local server and pull a compatible model first.
# AI_PROVIDER=openai-compatible AI_BASE_URL=http://localhost:11434/v1 AI_MODEL=REPLACE_WITH_INSTALLED_MODEL_ID bun run dev
